# Copy to .env. Everything has a working default; the two values marked REQUIRED matter for a real deployment.

# --- Model ---------------------------------------------------------------------------------------
# openai  : agents are driven by the model below. REQUIRED: OPENAI_API_KEY.
# offline : deterministic rule policy (CI, demos without a key). Also used automatically when the key is
#           missing or the provider is down; responses are then flagged "degraded": true.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=              # any endpoint that implements the OpenAI Responses API
REASONING_EFFORT=low
GUARDRAIL_REASONING_EFFORT=none
# JUDGE_MODEL=                  # evaluation only: grade with a different model than the one being graded
LLM_TIMEOUT_SECONDS=45
# Cost reporting only (USD per 1M tokens). Set these to your model's price list.
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50

# --- Deployment mode -------------------------------------------------------------------------------
# demo       : the challenge setup. Demo users are seeded and a generated JWT secret is tolerated.
# production : refuses to start while SEED_DEMO_USERS=true, JWT_SECRET is unset / shorter than 32 characters,
#              or METRICS_TOKEN is unset / shorter than 24.
APP_ENV=demo

# --- Identity ------------------------------------------------------------------------------------
# REQUIRED in any shared deployment: a long random string. If unset, a per-process secret is generated
# and every token dies on restart.   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=60
# Every token carries and must present these; a token for another service sharing the secret is refused.
JWT_ISSUER=getnet-support-auth
JWT_AUDIENCE=getnet-support-api
# Set true to require a verified Bearer token on /chat and /conversations/* (no anonymous visitor mode).
REQUIRE_CHAT_AUTH=false
# Demo identities cliente1988, cliente2026 (merchants) and operador1 (operator), all with DEMO_PASSWORD.
SEED_DEMO_USERS=true
DEMO_PASSWORD=getnet-demo
CHAT_RATE_LIMIT_ATTEMPTS=60
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Bounded autonomy ------------------------------------------------------------------------------
MAX_SUPERVISOR_STEPS=6
MAX_SPECIALIST_TOOL_STEPS=4
MAX_CRITIC_ROUNDS=2

# --- Memory ----------------------------------------------------------------------------------------
HISTORY_COMPACT_AFTER=16
HISTORY_KEEP_MESSAGES=8

# --- Human review ----------------------------------------------------------------------------------
HITL_TIMEOUT_SECONDS=900
HITL_LEASE_SECONDS=600

# --- Retrieval -------------------------------------------------------------------------------------
# bm25 | dense | hybrid. Choose from the numbers in `python -m eval.run --suite retrieval`.
RETRIEVAL_MODE=bm25
RETRIEVAL_TOP_K=4
# local = keyless hashing embedder; openai = EMBEDDING_MODEL through the API (cached on disk)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
INDEX_RAW_PAGES=false
ENABLE_LIVE_WEB=true

# --- Storage and HTTP ------------------------------------------------------------------------------
SQLITE_DB_PATH=data/support.db
CHECKPOINT_DB_PATH=data/checkpoints.db
TRACE_RETENTION_DAYS=30
CORS_ORIGINS=
LOG_LEVEL=INFO
# Reverse proxies whose X-Forwarded-For is believed for rate limiting (comma-separated). Empty: header ignored.
TRUSTED_PROXIES=
# Bearer token Prometheus presents on /metrics. REQUIRED in production; unset in demo = /metrics is open.
METRICS_TOKEN=
# Longest a GET /conversations/{id}?wait= long-poll may hold a request open.
MAX_CONVERSATION_WAIT_SECONDS=30
