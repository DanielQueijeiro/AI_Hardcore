# ============================================================================
# Getnet Multi-Agent Support System — Environment Configuration (.env.example)
# ============================================================================
# Zero-Cost Multi-Provider LLM Strategy (ADR-0004):
# Supported LLM_PROVIDER values:
#   - heuristic : (Default, $0 cost, zero external API keys required, 100% deterministic)
#   - groq      : Free-tier Groq Cloud API (e.g., llama-3.3-70b-versatile)
#   - gemini    : Free-tier Google AI Studio API (e.g., gemini-2.5-flash)
#   - ollama    : Local Ollama server (e.g., llama3.2 on http://localhost:11434)
#   - openai    : Optional OpenAI API (e.g., gpt-4o-mini)
# ============================================================================

LLM_PROVIDER=heuristic

# --- Option 1: Groq Cloud Free Tier ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option 2: Google Gemini Free Tier ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Option 3: Local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Option 4: OpenAI (Optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Data & Hybrid RAG Settings ---
SQLITE_DB_PATH=data/support.db
KNOWLEDGE_BASE_PATH=data/getnet_knowledge_base.md
GETNET_SCRAPE_URL=https://www.getnet.net/en
ENABLE_LIVE_WEB_SCRAPE=true
